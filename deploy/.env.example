# cut-045 — Demo Deployment .env template
#
# Copy this file to deploy/.env and edit values before `docker compose up`.
# DO NOT commit deploy/.env (it's a runtime secret).

# --- Database (postgres:16-pgvector) ----------------------------------------
POSTGRES_USER=ece
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=ece

# --- API service database connection (constructed from POSTGRES_* above) ---
# Format: postgresql+psycopg://<user>:<password>@<host>:5432/<db>
# Inside the docker network, the postgres host is the service name (postgres).
# From the host (for direct alembic / seed runs), use 127.0.0.1:55440 (or
# whatever port you map via `docker compose run --rm api alembic upgrade head`).
DATABASE_URL=postgresql+psycopg://ece:CHANGE_ME_LOCAL_ONLY@postgres:5432/ece

# --- ECE server today anchor (cut-043R3 R7-B1 server-owned anchor) ---------
# Strict YYYY-MM-DD canonical round-trip enforced at API boundary.
# Example: 2026-09-22
ECE_SERVER_TODAY_ANCHOR=2026-09-22

# --- API service ------------------------------------------------------------
# Container-internal port (matches Dockerfile CMD). NOT bound to host.
API_PORT=8000

# --- nginx reverse proxy on host -------------------------------------------
# DEMO_DOMAIN is the public hostname founders use for customer demos.
# Example: corln.rana.asia
DEMO_DOMAIN=corln.rana.asia

# --- Logging ---------------------------------------------------------------
ECE_LOG_LEVEL=INFO